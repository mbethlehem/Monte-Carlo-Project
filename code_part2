#define a function taking extremes of interval and mean of Gaussian density, returning a maximizer of the density on the interval 
inter_argmax<-function(a1,b1,mu){
  if (mu <= a1){
    return (a1)
  }else if (mu>=b1){
    return (b1)
  }else {
    return (mu)
  }
}
#define a function taking extremes of interval and mean of Gaussian density, returning a minimizer of the density on the interval 
inter_argmin<-function(a1,b1,mu){
  if (abs(a1-mu)>=abs(b1-mu)){
    return (a1)
  }else{
    return (b1)
  }
}


#define a function taking partition p as argument to calculate Integral of g
Integral_g<-function(p)
{ 
  b = p[[1]]
  c = p[[2]]
  k = p[[3]]
  res = 0
  partition_points = seq(b,c,length.out = k+1)
  linear_heights = numeric(k+1) 
  linear_heights[1] = pnorm(b,mu_1,s_1)
  l = (c-b)/k
  
  for (i in (1:k)){
    a1 = b + l*(i-1)
    b1 = b + l*i
    sup = dnorm(inter_argmax(a1,b1,mu_1),mu_1,s_1)
    inf = dnorm(inter_argmin(a1,b1,mu_2),mu_2,s_2)
    linear_heights[i+1] = linear_heights[i] + (sup - a*inf)*l
  }
  res = (linear_heights[k+1]+1-pnorm(c,mu_1,s_1))
  return (list(Ig = res/Z,pp = partition_points, lh = linear_heights/res))
}

